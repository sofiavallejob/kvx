#N canvas 60 40 780 960 12;
#X obj 0 0 cnv 1 780 52 empty empty 01 - presets in a dictionary 20 26 0 20 #ececec #202020 0;
#X text 20 70 Sound settings kept in a JSON file. Load it\, pick a preset\, and the dictionary answers with the frequency and loudness for the oscillator. Turn sound on first., f 72;
#X obj 20 150 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 158 1 - sound and file;
#X msg 40 190 \; pd dsp 1;
#X msg 148 190 \; pd dsp 0;
#X msg 240 190 read presets.json;
#X obj 240 250 kvx/dict presets;
#X obj 240 300 print info;
#X text 440 190 presets.json lives next to this patch. It has three presets: bass\, lead and bell., f 40;
#X obj 20 380 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 388 2 - pick a preset;
#X msg 40 420 symbol bass;
#X msg 180 420 symbol lead;
#X msg 320 420 symbol bell;
#X obj 40 490 t a a;
#X obj 40 550 makefilename %s.freq;
#X obj 40 590 list prepend get;
#X obj 40 630 list trim;
#X obj 40 680 kvx/dict presets;
#X obj 300 550 makefilename %s.amp;
#X obj 300 590 list prepend get;
#X obj 300 630 list trim;
#X obj 300 680 kvx/dict presets;
#X obj 40 740 osc~;
#X msg 300 740 \$1 30;
#X obj 300 790 line~;
#X obj 40 840 *~;
#X obj 40 880 dac~;
#X text 520 550 Two questions are asked of the same dictionary: bass.freq and bass.amp. The two answers go to the oscillator and its volume., f 34;
#X connect 6 0 7 0;
#X connect 7 1 8 0;
#X connect 12 0 15 0;
#X connect 13 0 15 0;
#X connect 14 0 15 0;
#X connect 15 0 16 0;
#X connect 16 0 17 0;
#X connect 17 0 18 0;
#X connect 18 0 19 0;
#X connect 15 1 20 0;
#X connect 20 0 21 0;
#X connect 21 0 22 0;
#X connect 22 0 23 0;
#X connect 19 0 24 0;
#X connect 24 0 27 0;
#X connect 23 0 25 0;
#X connect 25 0 26 0;
