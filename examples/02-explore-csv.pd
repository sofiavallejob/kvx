#N canvas 60 40 780 780 12;
#X obj 0 0 cnv 1 780 52 empty empty 02 - look at a CSV file 20 26 0 20 #ececec #202020 0;
#X text 20 70 quakes.csv is a made-up seismogram (12000 rows\, 100 per second)\, with a time column\, two channels and a station name. Read it\, ask about it\, and look at single rows., f 72;
#X obj 20 150 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 158 1 - read and ask;
#X msg 40 190 read quakes.csv;
#X msg 40 226 columns;
#X msg 40 262 rows;
#X msg 40 298 stats ch1;
#X msg 40 334 stats ch2;
#X obj 340 300 kvx/table;
#X obj 340 380 print info;
#X text 340 190 The answers appear in the Pd window\, not here. stats gives min\, max\, mean\, standard deviation and count. The time column counts seconds from the first row., f 46;
#X obj 20 450 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 458 2 - one row at a time;
#X msg 40 490 read quakes.csv;
#X floatatom 40 550 6 0 0 0 - - - 0;
#X msg 40 590 row \$1;
#X obj 340 590 kvx/table;
#X obj 340 650 unpack f f f s;
#X floatatom 340 710 8 0 0 0 - - - 0;
#X floatatom 430 710 8 0 0 0 - - - 0;
#X floatatom 520 710 8 0 0 0 - - - 0;
#X symbolatom 610 710 8 0 0 0 - - - 0;
#X text 40 640 Click the number box and drag\, or type a row number. The four boxes on the right show time\, ch1\, ch2 and station., f 34;
#X connect 4 0 9 0;
#X connect 5 0 9 0;
#X connect 6 0 9 0;
