#N canvas 60 40 780 860 12;
#X obj 0 0 cnv 1 780 52 empty empty 03 - play rows as notes 20 26 0 20 #ececec #202020 0;
#X text 20 70 Each row of the file becomes one note. ch1 chooses the pitch and ch2 the loudness. Turn sound on\, read the file\, and press play., f 72;
#X obj 20 150 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 158 1 - sound and file;
#X msg 40 190 \; pd dsp 1;
#X msg 148 190 \; pd dsp 0;
#X msg 240 190 read quakes.csv -stride 30;
#X text 240 230 -stride 30 keeps every 30th row\, so 12000 rows become 400., f 40;
#X obj 20 330 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 338 2 - play;
#X msg 40 370 play 40;
#X msg 130 370 play 10;
#X msg 40 410 stop;
#X msg 130 410 reset;
#X obj 340 370 kvx/table;
#X obj 540 370 print info;
#X obj 340 440 unpack f f f s;
#X obj 340 520 * 12;
#X obj 340 560 + 60;
#X obj 340 600 mtof;
#X obj 340 640 osc~;
#X msg 480 520 \$1 20;
#X obj 480 600 line~;
#X obj 340 700 *~;
#X obj 340 740 *~ 0.3;
#X obj 340 790 dac~;
#X text 40 480 play 40 sends one row every 40 ms. The row comes out as a list and [unpack] splits it. ch1 (-1 to 1) moves the pitch one octave up and down around middle C. ch2 (0 to 1) is the volume., f 40;
