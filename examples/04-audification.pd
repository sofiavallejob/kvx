#N canvas 60 40 780 780 12;
#X obj 0 0 cnv 1 780 52 empty empty 04 - audification: a column becomes sound 20 26 0 20 #ececec #202020 0;
#X text 20 70 The whole ch1 column is copied into a Pd array and played back as audio\, fast enough to hear it. Turn sound on\, read\, copy\, then choose a speed., f 72;
#X obj 20 150 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 158 1 - read and copy;
#X msg 40 190 read quakes.csv;
#X msg 40 226 toarray ch1 wave norm;
#X obj 40 290 kvx/table;
#X obj 200 290 route toarray;
#X obj 200 330 unpack s f;
#N canvas 0 0 450 300 (subpatch) 0;
#X array wave 100 float 0;
#X coords 0 1 99 -1 380 100 1 0 0;
#X restore 340 190 graph;
#X text 340 310 norm scales the column to -1 .. 1. The array is resized to 12000 samples., f 46;
#X obj 20 430 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 438 2 - play it;
#X msg 40 470 \; pd dsp 1;
#X msg 148 470 \; pd dsp 0;
#X msg 240 470 0.5;
#X msg 240 506 2;
#X msg 240 542 8;
#X msg 240 578 30;
#X msg 240 614 0;
#X obj 340 480 phasor~;
#X obj 340 530 *~ 12000;
#X obj 340 580 tabread4~ wave;
#X obj 340 630 *~ 0.5;
#X obj 340 680 dac~;
#X text 520 480 The numbers are how many times per second the whole record plays. 0.5 is two seconds for all of it\, 30 is a low rumble. 0 stops., f 30;
#X connect 4 0 6 0;
#X connect 5 0 6 0;
#X connect 6 1 7 0;
#X connect 7 0 8 0;
#X connect 15 0 20 0;
#X connect 16 0 20 0;
#X connect 17 0 20 0;
#X connect 18 0 20 0;
#X connect 19 0 20 0;
#X connect 20 0 21 0;
#X connect 21 0 22 0;
#X connect 22 0 23 0;
#X connect 23 0 24 0;
#X connect 23 0 24 1;
#X connect 8 1 21 1;
