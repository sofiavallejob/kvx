#N canvas 60 40 780 780 12;
#X obj 0 0 cnv 1 780 52 empty empty 05 - files from Europe (semicolons and decimal commas) 20 26 0 20 #ececec #202020 0;
#X text 20 70 Many spreadsheets in Europe write 6\,5 for 6.5 and separate columns with a semicolon. Without help\, the numbers stay text. With -decimal comma they become numbers., f 72;
#X obj 20 150 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 158 1 - without options;
#X msg 40 190 read european.csv;
#X msg 40 226 row 0;
#X obj 340 220 kvx/table;
#X obj 340 290 print data;
#X obj 480 290 print info;
#X text 340 330 The row comes out with words like 6\,5 instead of numbers., f 46;
#X obj 20 430 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 438 2 - with options;
#X msg 40 470 read european.csv -delim semicolon -decimal comma;
#X msg 40 506 columns;
#X msg 40 542 row 0;
#X msg 40 578 stats temperatur;
#X obj 340 650 kvx/table;
#X obj 340 720 print data;
#X obj 480 720 print info;
#X text 40 640 Now row 0 is numbers\, and the date is turned into seconds from the first row., f 34;
#X connect 4 0 6 0;
#X connect 5 0 6 0;
#X connect 6 0 7 0;
#X connect 6 1 8 0;
#X connect 12 0 16 0;
#X connect 13 0 16 0;
#X connect 14 0 16 0;
#X connect 15 0 16 0;
