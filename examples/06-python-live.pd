#N canvas 60 40 780 1040 12;
#X obj 0 0 cnv 1 780 52 empty empty 06 - Python controls a sound 20 26 0 20 #ececec #202020 0;
#X text 20 70 Python writes a frequency and a volume into the dictionary\, and the patch reads them ten times a second. Start this patch\, turn sound on\, then run python_demo.py from the examples folder., f 72;
#X obj 20 150 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 158 1 - the connection;
#X obj 40 200 netreceive 9001;
#X obj 40 270 kvx/dict live;
#X obj 40 360 netsend;
#X msg 300 300 connect localhost 9002;
#X msg 300 340 disconnect;
#X floatatom 40 410 4 0 0 0 - - - 0;
#X text 300 200 The same connection as in python-bridge.pd. Click connect\, the number shows 1 when it works., f 46;
#X obj 20 490 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 498 2 - listen;
#X msg 40 530 \; pd dsp 1;
#X msg 148 530 \; pd dsp 0;
#X msg 240 530 1;
#X msg 240 566 0;
#X obj 240 620 metro 100;
#X obj 240 670 t b b;
#X msg 240 720 get synth.freq;
#X msg 440 720 get synth.amp;
#X obj 240 780 kvx/dict live;
#X obj 440 780 kvx/dict live;
#X obj 240 840 osc~;
#X msg 440 840 \$1 50;
#X obj 440 880 line~;
#X obj 240 920 *~;
#X obj 240 960 dac~;
