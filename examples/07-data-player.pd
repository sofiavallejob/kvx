#N canvas 60 40 780 1340 12;
#X obj 0 0 cnv 1 780 52 empty empty 07 - data player: play by date and scrub 20 26 0 20 #ececec #202020 0;
#X text 20 70 Three years of daily climate numbers (made up) played by their dates. Temperature is the pitch\, CO2 opens the filter and rain is hiss. Load\, turn sound on and press play., f 72;
#X obj 20 150 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 158 1 - load and sound;
#X msg 40 190 read climate.csv \, range temp 48 84 \, range co2 300 3000 \, range rain 0 0.3;
#X obj 40 240 s \$0-player;
#X msg 40 290 \; pd dsp 1;
#X msg 148 290 \; pd dsp 0;
#X text 260 290 range scales a column on the way out: temperature becomes notes 48 to 84\, CO2 a filter from 300 to 3000 Hz., f 60;
#X obj 20 370 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 378 2 - transport;
#X msg 40 410 play -time 1728000;
#X msg 204 410 pause;
#X msg 277 410 play;
#X msg 343 410 reset;
#X msg 416 410 loop 1;
#X msg 496 410 loop 0;
#X obj 40 460 s \$0-player;
#X text 40 500 play -time 1728000 follows the date column\, 1728000 seconds of data per second: one day every 50 ms. pause stops where it is\, play goes on from there., f 70;
#X msg 40 580 speed 864000;
#X msg 162 580 speed 1728000;
#X msg 291 580 speed 5184000;
#X msg 420 580 at 31536000;
#X msg 535 580 at 63072000;
#X obj 40 630 s \$0-player;
#X text 40 670 speed changes the pace while it plays (864000 is a day every 100 ms). at jumps to a time in seconds from the start: 31536000 is one year in., f 70;
#X obj 40 760 hsl 300 18 0 1 0 0 empty empty scrub -2 -10 0 12 #ffffff #5a5a5a #303030 0 1;
#X msg 40 800 pos \$1;
#X obj 40 840 s \$0-player;
#X text 420 760 Drag to jump anywhere. The slider in part 3 shows where the player is., f 44;
#X obj 20 900 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 908 3 - the player and the sound;
#X obj 40 940 r \$0-player;
#X obj 40 980 kvx/table;
#X obj 40 1040 unpack f f f f;
#X obj 240 1040 print player;
#X msg 420 1040 set \$1;
#X obj 420 1090 hsl 300 18 0 1 0 0 empty empty position -2 -10 0 12 #ffffff #5a5a5a #303030 0 1;
#X obj 40 1110 / 86400;
#X floatatom 40 1150 6 0 0 0 - - - 0;
#X text 110 1150 day, f 6;
#X obj 160 1190 s \$0-cut;
#X obj 300 1110 mtof;
#X obj 300 1150 phasor~;
#X obj 420 1150 r \$0-cut;
