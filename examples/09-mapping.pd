#N canvas 60 40 780 1360 12;
#X obj 0 0 cnv 1 780 52 empty empty 09 - mapping: data to notes and drums 20 26 0 20 #ececec #202020 0;
#X text 20 70 Parameter mapping. The temperature (smoothed over a week) picks notes from a pentatonic scale\, and every rainy day plays a drum hit. Load\, turn sound on\, press play., f 72;
#X obj 20 150 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 158 1 - load and sound;
#X msg 40 190 read climate.csv \, smooth temp 7 temp7 \, range temp7 0 14.99 \, range rain 0 1;
#X obj 40 240 s \$0-map;
#X msg 40 290 \; pd dsp 1;
#X msg 148 290 \; pd dsp 0;
#X text 260 290 smooth adds a column temp7: the mean over 7 rows. range turns it into steps 0 to 14 (three octaves of five notes)., f 60;
#X obj 20 370 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 378 2 - play;
#X msg 40 410 play 150;
#X msg 134 410 play 60;
#X msg 221 410 stop;
#X msg 287 410 reset;
#X msg 360 410 loop 1;
#X obj 40 460 s \$0-map;
#X text 40 500 play 150 is one day every 150 ms. Try play 60 for faster., f 70;
#X obj 20 560 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 568 3 - the mapping;
#X obj 40 600 r \$0-map;
