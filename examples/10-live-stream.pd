#N canvas 60 40 780 1420 12;
#X obj 0 0 cnv 1 780 52 empty empty 10 - live data from Python 20 26 0 20 #ececec #202020 0;
#X text 20 70 Python sends three values 50 times a second (a phone sensor log played back live). [kvx/stream] keeps the newest 2000 rows. Open this patch\, turn sound on\, click 1\, then run python_stream_demo.py., f 72;
#X obj 20 150 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 158 1 - receive;
#X obj 40 190 netreceive 9001;
#X obj 40 240 route stream;
#X obj 40 290 kvx/stream 3 2000;
#X obj 220 250 r \$0-st;
#X obj 40 350 s \$0-row;
#X obj 240 350 route stats;
#X obj 240 390 s \$0-stats;
#X obj 400 390 print stream;
#X text 420 190 Python writes lines like [stream push 0.1 0.5 0.8(. [route stream] passes on the push to the buffer., f 44;
#X obj 20 450 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 458 2 - listen and look;
#X msg 40 490 \; pd dsp 1;
#X msg 148 490 \; pd dsp 0;
#X msg 40 560 1;
#X msg 85 560 0;
#X obj 40 600 metro 20;
#X obj 40 640 t b b b;
#X msg 40 690 bang;
#X msg 106 690 stats col1 400;
#X msg 242 690 toarray col1 live-scope 400;
#X obj 40 740 s \$0-st;
#X text 140 560 Every 20 ms: the newest row for the sound\, the statistics of the last 400 rows\, and the last 400 values drawn below., f 60;
#N canvas 0 0 450 300 (subpatch) 0;
#X array live-scope 400 float 0;
#X coords 0 1.5 399 -1.5 340 100 1 0 0;
#X restore 40 800 graph;
#X obj 420 800 r \$0-stats;
#X obj 420 840 unpack s f f f;
#X floatatom 420 880 6 0 0 0 - - - 0;
#X floatatom 500 880 6 0 0 0 - - - 0;
#X floatatom 580 880 6 0 0 0 - - - 0;
#X text 420 910 min   max   mean, f 30;
#X obj 20 960 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 968 3 - sound;
#X obj 40 1000 r \$0-row;
#X obj 40 1040 unpack f f f;
#X obj 40 1090 * 12;
#X obj 40 1130 + 60;
#X obj 40 1170 mtof;
#X obj 40 1210 phasor~;
#X obj 40 1250 lop~ 1000;
