#N canvas 60 40 780 1000 12;
#X obj 0 0 cnv 1 780 52 empty empty 11 - NumPy and JSON Lines files and saving 20 26 0 20 #ececec #202020 0;
#X text 20 70 [kvx/table] also reads .npy files (from NumPy) and .jsonl files (one JSON object per line\, common for logs and web APIs). Everything you can do with a CSV works the same. The answers go to the Pd window., f 72;
#X obj 20 150 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 158 1 - read;
#X msg 40 190 read signal.npy;
#X msg 183 190 columns;
#X msg 270 190 rows;
#X msg 336 190 stats col1;
#X obj 40 240 s \$0-f;
#X msg 40 290 read sensors.jsonl -cols time ax label;
#X msg 344 290 row 10;
#X msg 424 290 stats ax;
#X obj 40 340 s \$0-f;
#X text 40 380 .npy columns are called col1\, col2 ... JSON Lines columns take the names of the fields in the first line. Dates in text become seconds\, like in a CSV., f 70;
#X obj 20 460 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 468 2 - thin out\, cut and save;
#X msg 40 500 read sensors.jsonl;
#X msg 204 500 decimate 10 minmax ax;
#X msg 389 500 crop -time 30 60;
#X msg 539 500 rows;
#X obj 40 550 s \$0-f;
#X msg 40 600 write sensors-small.csv time ax label;
#X msg 337 600 read sensors-small.csv;
#X msg 529 600 row 0;
#X obj 40 650 s \$0-f;
#X text 40 690 decimate 10 minmax ax keeps two rows of every ten: where ax is lowest and highest\, so peaks survive. crop -time keeps seconds 30 to 60. write saves a CSV next to this patch\, with the dates written as dates., f 70;
#X obj 20 800 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 808 3 - answers;
#X obj 40 840 r \$0-f;
#X obj 40 880 kvx/table;
#X obj 40 930 print data;
#X obj 200 930 print info;
