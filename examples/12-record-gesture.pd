#N canvas 60 40 780 1300 12;
#X obj 0 0 cnv 1 780 52 empty empty 12 - record a gesture and play it back 20 26 0 20 #ececec #202020 0;
#X text 20 70 Move the sliders while recording: every 20 ms their values become a row in the table. Then play the rows back\, the sliders move by themselves\, and save it as a CSV., f 72;
#X obj 20 150 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 158 1 - play with the sliders;
#X obj 40 200 hsl 300 18 40 90 0 0 empty \$0-ps pitch -2 -10 0 12 #ffffff #5a5a5a #303030 0 1;
#X obj 40 230 s \$0-pitch;
#X obj 40 290 hsl 300 18 200 6000 0 0 empty \$0-bs brightness -2 -10 0 12 #ffffff #5a5a5a #303030 0 1;
#X obj 40 320 s \$0-bright;
#X msg 440 190 \; pd dsp 1;
#X msg 548 190 \; pd dsp 0;
#X obj 440 260 r \$0-pitch;
#X obj 440 300 mtof;
#X obj 440 340 phasor~;
#X obj 580 340 r \$0-bright;
#X obj 440 380 lop~ 1000;
#X obj 440 420 *~ 0.2;
#X obj 440 460 dac~;
#X obj 20 520 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 528 2 - record;
#X msg 40 560 clear;
#X obj 40 610 s \$0-rec;
#X text 140 560 clear first\, then 1 starts recording and 0 stops., f 50;
#X msg 40 650 1;
#X msg 85 650 0;
#X obj 40 700 metro 20;
#X obj 40 740 t b b;
#X obj 160 700 r \$0-pitch;
#X obj 300 700 r \$0-bright;
#X obj 40 790 f;
#X obj 160 790 f;
#X obj 40 840 pack f f;
