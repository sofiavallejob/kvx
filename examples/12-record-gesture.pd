#X obj 40 920 s \$0-rec;
#X obj 20 980 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 988 3 - play back and save;
#X msg 40 1020 play 20;
#X msg 127 1020 stop;
#X msg 193 1020 reset;
#X msg 266 1020 loop 1;
#X msg 346 1020 loop 0;
#X msg 426 1020 rows;
#X msg 492 1020 write gesture.csv;
#X msg 649 1020 read gesture.csv;
#X obj 40 1070 s \$0-rec;
#X obj 40 1120 r \$0-rec;
