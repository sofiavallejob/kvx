#N canvas 60 40 780 2160 12;
#X obj 0 0 cnv 1 780 52 empty empty kvx/dict 20 26 0 20 #ececec #202020 0;
#X text 20 70 A dictionary for nested data: numbers\, words\, lists and objects\, the same shape as JSON. Objects with the same name share one dictionary\, anywhere in Pd. Left outlet: values. Middle outlet: answers about the data. Right outlet: replies to other programs., f 72;
#X obj 20 150 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 158 1 - store and read values;
#X msg 40 190 set synth.freq 220;
#X msg 40 226 set synth.name saw;
#X msg 40 262 set notes 60 64 67;
#X msg 40 320 get synth.freq;
#X msg 40 356 get notes;
#X msg 40 392 get synth;
#X obj 340 290 kvx/dict demo;
#X obj 340 360 print value;
#X obj 480 360 print info;
#X text 340 190 A path like synth.freq goes down into objects. One value is stored as a number or a word. Several values are stored as a list., f 46;
#X text 340 410 A number or word comes out as itself. A flat list comes out as a list. Anything nested comes out as [json <text>( ., f 46;
#X obj 20 500 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 508 2 - paths and nesting;
#X msg 40 540 set a.b.c 1;
#X msg 40 576 set a.b.d hello;
#X msg 40 612 set list.0 10;
#X msg 40 670 get a;
#X msg 40 706 get a.b.c;
#X msg 40 742 del a.b.d;
#X obj 340 650 kvx/dict demo;
#X obj 340 720 print value;
#X obj 480 720 print info;
#X text 340 540 list.0 and list[0] are the first item of a list. Missing parents are created. A number in the path makes a list\, a name makes an object., f 46;
#X text 340 780 Setting inside a plain value replaces it with a new container. Deleting from a list shifts the rest down., f 46;
#X obj 20 860 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 868 3 - JSON files;
#X msg 40 900 read kvx-demo.json;
#X msg 40 936 print;
#X msg 40 972 tojson pretty;
#X msg 40 1020 keys;
#X msg 40 1056 keys synth;
#X msg 40 1092 size synth.partials;
#X msg 40 1128 type title;
#X msg 40 1164 has synth.name;
#X msg 40 1212 write kvx-out.json pretty;
#X msg 40 1248 clear;
#X obj 340 1020 kvx/dict demo;
#X obj 340 1100 print value;
#X obj 480 1100 print info;
#X text 340 900 read loads a JSON file next to this patch (or a full path) and replaces the dictionary. print shows it in the Pd window. tojson gives it back as one [json <text>( message., f 46;
#X text 340 1140 keys \, size \, type \, has answer on the middle outlet., f 46;
#X text 340 1214 write saves the dictionary (next to the patch unless you give a full path). clear empties it., f 46;
#X obj 20 1330 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 1338 4 - other programs;
#X text 40 1370 [req <id> <message>( runs any message and answers on the right outlet as [send reply <id> ...( \, ready to connect to [netsend]. Python uses this: see python-bridge.pd., f 72;
#X msg 40 1440 req 7 get synth.freq;
#X msg 40 1476 req 8 keys synth;
#X msg 40 1512 req 9 set x.y 5;
#X obj 340 1476 kvx/dict demo;
#X obj 340 1546 print reply;
#X obj 20 1620 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 1628 reference;
#X text 40 1650 set path v ...   one value is a number or word\, several make a list.   setjson path text   JSON text into a path.   json text   replace everything.   setnull path   setbool path 0/1, f 76;
#X text 40 1720 get [path]   tojson [path] [pretty]   print [path]   bang (whole dictionary as json)   has path   type path   keys [path]   size [path], f 76;
#X text 40 1774 push path v ...   append to a list (made if missing). Several values are appended as one nested list.   del path   clear   read file   write file [pretty]   req id message ..., f 76;
#X text 40 1844 types: object array string number bool null missing.  null comes out as the word null\, true and false as 1 and 0 (ask type to tell them from numbers). A list of one item comes out as a plain value., f 76;
#X text 40 1914 JSON text cannot go in a message box (commas and quotes are special there). Use read\, a symbol\, or Python., f 76;
#X text 40 1968 Pd never frees symbols. For big data that changes a lot\, use read and write instead of passing JSON text around., f 76;
#X text 40 2022 jsonbuf text   jsonapply [path]   JSON text in pieces\, for values longer than one message can carry. Python uses them for big values., f 76;
#X text 40 2076 Arguments: an optional name. [kvx/dict \$0-data] keeps the dictionary private to one patch or abstraction. No name\, no sharing., f 76;
