#N canvas 60 40 780 1320 12;
#X obj 0 0 cnv 1 780 52 empty empty kvx/stream 20 26 0 20 #ececec #202020 0;
#X text 20 70 A buffer for live data: rows come in from Pd or from Python and the newest are kept. Ask for the last row\, statistics of the last n rows\, or copy the last n values into an array. Arguments: columns and rows to keep\, [kvx/stream 3 1000]., f 72;
#X obj 20 150 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 158 1 - push and ask;
#X msg 40 190 push 1 2 3;
#X msg 148 190 push 4 5 6 7 8 9;
#X msg 298 190 bang;
#X msg 364 190 get 1;
#X msg 437 190 rows;
#X obj 40 240 s \$0-s1;
#X msg 40 290 columns a b c;
#X msg 169 290 push 10 20 30;
#X msg 298 290 stats b;
#X msg 385 290 stats b 2;
#X msg 486 290 columns;
#X obj 40 340 s \$0-s1;
#X obj 40 390 r \$0-s1;
#X obj 40 430 kvx/stream 3 1000;
#X obj 40 490 print data;
#X obj 190 490 print info;
#X text 40 540 push takes one row\, or several rows one after the other. bang is the newest row\, get 1 the one before. rows answers how many are kept and how many came in. columns names the columns (a different number of columns starts again empty)., f 72;
#X obj 20 640 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 648 2 - live from Pd;
#X msg 40 680 1;
#X msg 85 680 0;
#X obj 40 720 metro 20;
#X obj 40 760 t b b;
#X obj 160 800 random 1000;
#X obj 160 840 / 1000;
#X msg 40 880 toarray col1 kvx-scope 200;
#X obj 40 930 kvx/stream 1 200;
#N canvas 0 0 450 300 (subpatch) 0;
#X array kvx-scope 200 float 0;
#X coords 0 1 199 -1 300 100 1 0 0;
#X restore 420 700 graph;
#X text 420 850 Every 20 ms a random number goes in\, and the last 200 are drawn. A float or a list into the left inlet is the same as push., f 44;
#X obj 20 1000 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 1008 3 - from Python;
#X text 40 1040 [netreceive 9001] -> [route stream] -> [kvx/stream 3 2000]. In Python: pd = pdkv.Client() then pd.push_rows(rows). See 10-live-stream.pd in the examples folder., f 72;
#X obj 20 1120 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 1128 reference;
#X text 40 1150 push v ... (or a float or list)   bang   get k   rows   columns [names]   stats col [n]   toarray col array [n] [norm]   thru 0|1 (pass every new row out)   clear   size n, f 76;
#X text 40 1220 Left outlet: rows. Right outlet: rows held total\, columns ...\, stats col min max mean std count\, error text. With no data yet\, bang\, stats and toarray do nothing., f 76;
