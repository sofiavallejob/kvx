#N canvas 60 40 780 2010 12;
#X obj 0 0 cnv 1 780 52 empty empty kvx/table 20 26 0 20 #ececec #202020 0;
#X text 20 70 Reads CSV and TSV files into Pd for sonification. Columns are kept as numbers\, so big files stay small. Delimiter\, header and dates are detected. Left outlet: data. Right outlet: information about the data., f 72;
#X obj 20 150 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 158 1 - read a file;
#X msg 40 190 read kvx-demo.csv;
#X msg 40 226 columns;
#X msg 40 262 rows;
#X msg 40 298 get 3 temp;
#X msg 40 334 row 3;
#X msg 40 370 stats temp;
#X obj 340 300 kvx/table;
#X obj 340 380 print data;
#X obj 480 380 print info;
#X text 340 190 read loads a CSV or TSV next to this patch (or a full path). Every column becomes a list of numbers\, text columns stay words., f 46;
#X text 340 430 Columns are named by the header and counted from 0\, rows too. Empty cells come out as 0 (change it with [nan -1( ). row gives a whole row as a list\, for example into [unpack f f f s]., f 46;
#X obj 20 540 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 548 2 - big files and dates;
#X msg 40 580 read kvx-demo.csv -stride 2;
#X msg 40 616 read kvx-demo.csv -cols time temp;
#X msg 40 652 read kvx-demo.csv -maxrows 10;
#X msg 40 688 read kvx-demo.csv -skip 20;
#X msg 40 724 rows;
#X obj 340 720 kvx/table;
#X obj 340 790 print info;
#X text 340 580 -stride 10 keeps every 10th row\, -cols picks columns by name or number\, -maxrows stops early\, -skip drops lines at the top. The file is read row by row and never held as text\, so a file with millions of rows is fine. Use stride to thin out a long recording., f 46;
#X text 340 840 Dates like 2024-03-05T10:20:30Z become seconds. They count from the first row (a Pd float cannot hold a whole date)\, and the start comes out as [timeorigin( on the right outlet. -reltime 0 keeps the full value., f 46;
#X obj 20 960 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 968 3 - into a Pd array;
#X msg 40 1000 read kvx-demo.csv;
#X msg 40 1036 toarray temp wave;
#X msg 40 1072 toarray temp wave norm;
#X obj 340 1180 kvx/table;
#N canvas 0 0 450 300 (subpatch) 0;
#X array wave 60 float 3;
#X coords 0 1 59 -1 200 100 1 0 0;
#X restore 340 1000 graph;
#X text 40 1130 toarray copies a column into a Pd array and resizes the array to fit. norm scales it to -1 .. 1\, ready for [tabread4~] or [tabplay~]., f 40;
#X obj 20 1290 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 1298 4 - step through the rows or play them;
#X msg 40 1330 reset;
#X msg 40 1366 bang;
#X msg 40 1402 seek 30;
#X msg 40 1438 play 100;
#X msg 40 1474 stop;
#X obj 340 1440 kvx/table;
#X obj 340 1510 print data;
#X obj 480 1510 print info;
#X text 340 1330 bang outputs the next row and moves on. After the last row [end( comes out of the right outlet. play 100 outputs one row every 100 ms\, from where it is. seek jumps to a row and reset goes back to the start., f 46;
#X obj 20 1600 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 1608 reference;
#X text 40 1630 read file [-stride n] [-maxrows n] [-skip n] [-cols a b 3] [-delim comma|semicolon|tab] [-decimal point|comma] [-header 0|1] [-reltime 0|1], f 76;
#X text 40 1700 columns   rows   get row col   row n   stats col   toarray col array [norm]   nan value   bang   reset   seek n   play [ms]   stop   clear, f 76;
#X text 40 1770 Right outlet: loaded rows cols\, columns ...\, rows n\, stats col min max mean std count\, toarray name n\, timeorigin col seconds\, end\, error text., f 76;
#X text 40 1840 Files with a decimal comma (1\,5) need -decimal comma and usually -delim semicolon. Without a header\, columns are called col1\, col2 ... Quoted cells and Windows line ends are fine. Lines starting with # are ignored., f 76;
#X text 40 1926 The first row is a header if any cell in it is text. Force it with -header 1 or -header 0., f 76;
