#N canvas 60 40 780 3324 12;
#X obj 0 0 cnv 1 780 52 empty empty kvx/table 20 26 0 20 #ececec #202020 0;
#X text 20 70 Reads CSV\, TSV\, NumPy (.npy) and JSON Lines (.jsonl) files into Pd. Columns are kept as numbers\, so big files stay small. Left outlet: data. Middle: information about the data. Right: where the player is (0 to 1)., f 72;
#X obj 20 150 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 158 1 - read and ask;
#X msg 40 190 read kvx-demo.csv;
#X msg 197 190 columns;
#X msg 284 190 rows;
#X msg 350 190 get 3 temp;
#X msg 458 190 row 3;
#X msg 531 190 stats temp;
#X obj 40 240 s \$0-t1;
#X obj 40 290 r \$0-t1;
#X obj 40 330 kvx/table;
#X obj 40 390 print data;
#X obj 190 390 print info;
#X text 40 440 read loads a file next to this patch (or a full path). Delimiter\, header and decimal point are found by themselves. Columns have names and are counted from 0\, rows too. stats gives min\, max\, mean\, standard deviation and count. The answers appear in the Pd window., f 72;
#X obj 20 540 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 548 2 - big files\, dates and other formats;
#X msg 40 580 read kvx-demo.csv -stride 2;
#X msg 267 580 read kvx-demo.csv -cols time temp;
#X msg 536 580 rows;
#X obj 40 630 s \$0-t2;
#X msg 40 680 read kvx-demo.csv -maxrows 10;
#X msg 281 680 read kvx-demo.csv -skip 20;
#X msg 501 680 rows;
#X obj 40 730 s \$0-t2;
#X obj 40 780 r \$0-t2;
#X obj 40 820 kvx/table;
#X obj 40 880 print data;
#X obj 190 880 print info;
#X text 40 930 -stride 10 keeps every 10th row\, -cols picks columns by name or number\, -maxrows stops early\, -skip drops lines at the top. Files are read row by row\, so millions of rows are fine. Dates like 2024-03-05T10:20:30Z become seconds counted from the first row (a Pd number cannot hold a whole date)\, and the start comes out as timeorigin. Files ending in .npy or .jsonl are read as NumPy and JSON Lines., f 72;
#X obj 20 1070 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 1078 3 - Pd arrays;
#X msg 40 1110 read kvx-demo.csv;
#X msg 197 1110 toarray temp kvx-wave norm;
#X msg 417 1110 columns;
#X obj 40 1160 s \$0-t3;
#X msg 40 1210 toarrays temp kvx-wave quake kvx-wave2;
#X msg 344 1210 fromarray copy kvx-wave;
#X obj 40 1260 s \$0-t3;
#N canvas 0 0 450 300 (subpatch) 0;
#X array kvx-wave 60 float 0;
#X coords 0 1 59 -1 300 90 1 0 0;
#X restore 40 1320 graph;
#N canvas 0 0 450 300 (subpatch) 0;
#X array kvx-wave2 60 float 0;
#X coords 0 1 59 -1 300 90 1 0 0;
#X restore 420 1320 graph;
#X obj 40 1450 r \$0-t3;
#X obj 40 1490 kvx/table;
#X obj 40 1550 print data;
#X obj 190 1550 print info;
#X text 340 1450 toarray copies a column into an array and resizes it. norm scales to -1 .. 1. toarrays fills several arrays at once. fromarray turns an array into a new column., f 54;
#X obj 20 1600 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 1608 4 - play;
#X msg 40 1640 read kvx-demo.csv;
#X msg 197 1640 play 100;
#X msg 291 1640 play -time 4;
#X msg 413 1640 pause;
#X msg 486 1640 play;
#X msg 552 1640 reset;
#X obj 40 1690 s \$0-t4;
#X msg 40 1740 speed 0.5;
#X msg 141 1740 speed 10;
#X msg 235 1740 loop 1;
#X msg 315 1740 loop 0;
#X msg 395 1740 seek 30;
#X msg 482 1740 at 45;
#X msg 555 1740 bang;
#X obj 40 1790 s \$0-t4;
#X obj 40 1860 hsl 300 18 0 1 0 0 empty empty scrub -2 -10 0 12 #ffffff #5a5a5a #303030 0 1;
#X msg 40 1900 pos \$1;
#X obj 40 1940 s \$0-t4;
#X text 420 1860 play 100 sends a row every 100 ms. play -time 4 follows the time column at 4 times its real speed. speed changes the pace\, loop starts again at the end\, seek jumps to a row\, at to a time in seconds and pos to a point from 0 to 1. bang steps one row., f 44;
#X obj 40 2000 r \$0-t4;
#X obj 40 2040 kvx/table;
#X obj 40 2100 print data;
#X obj 190 2100 print info;
#X msg 420 2100 set \$1;
#X obj 420 2150 hsl 300 18 0 1 0 0 empty empty position -2 -10 0 12 #ffffff #5a5a5a #303030 0 1;
#X obj 20 2220 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 2228 5 - change the data;
#X msg 40 2260 read kvx-demo.csv;
#X msg 197 2260 range temp 0 127;
#X msg 347 2260 row 0;
#X msg 420 2260 range off;
#X msg 521 2260 row 0;
#X obj 40 2310 s \$0-t5;
#X msg 40 2360 derive temp;
#X msg 155 2360 smooth temp 5 t5;
#X msg 305 2360 columns;
#X msg 392 2360 decimate 4 minmax temp;
#X msg 584 2360 crop 0 5;
#X msg 678 2360 rows;
#X obj 40 2410 s \$0-t5;
#X msg 40 2460 clear;
#X msg 113 2460 append 1 2.5 hello;
#X msg 277 2460 append 2 3.5 world;
#X msg 441 2460 row 1;
#X msg 514 2460 write kvx-out.csv;
#X obj 40 2510 s \$0-t5;
#X obj 40 2560 r \$0-t5;
#X obj 40 2600 kvx/table;
#X obj 40 2660 print data;
#X obj 190 2660 print info;
#X text 40 2710 range scales a column on its way out (here to 0 .. 127). derive adds the change from row to row\, smooth a moving average. decimate 4 keeps one row in four: first\, mean\, or minmax col which keeps the highest and lowest rows so peaks survive. crop keeps a part. append adds a row (a new table if there is none) and write saves a CSV\, dates written as dates., f 72;
#X obj 20 2860 cnv 1 740 1 empty empty empty 0 0 0 12 #c8c8c8 #c8c8c8 0;
#X text 20 2868 reference;
#X text 40 2890 read file [-stride n] [-maxrows n] [-skip n] [-cols a b 3] [-delim comma|semicolon|tab] [-decimal point|comma] [-header 0|1] [-reltime 0|1]   write file [cols]   append v ...   clear, f 76;
#X text 40 2960 columns   rows   get row col   row n   stats col   range col lo hi | range col off | range off   nan value, f 76;
#X text 40 3014 toarray col array [norm]   toarrays col array ... [norm]   fromarray newcol array   derive col [name]   smooth col n [name]   decimate n [first|mean|minmax col]   crop start count | crop -time from to, f 76;
#X text 40 3084 bang   play [ms]   play -time [speed] [col]   pause   stop   speed n   loop 0|1   reset   seek row   at seconds   pos 0..1, f 76;
#X text 40 3138 Middle outlet: loaded rows cols\, columns ...\, rows n\, stats col min max mean std count\, toarray name n\, toarrays n rows\, timeorigin col seconds\, written file rows\, loop\, end\, error text., f 76;
#X text 40 3208 Empty cells come out as 0 (change with nan). Text columns come out as words. Without a header\, columns are called col1\, col2 ... Lines starting with # are skipped. Files with a decimal comma need -decimal comma., f 76;
